<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_submit_vote_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit your vote?"
        android:textColor="@color/vg_text"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="You cannot change your vote after submitting."
        android:textColor="@color/vg_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReviewVote"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/vg_soft_blue"
            android:text="Go Back"
            android:textAllCaps="false"
            android:textColor="@color/vg_navy"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirmVote"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/vg_navy"
            android:text="Submit Vote"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
